load("//dart:defs.bzl", "dart_library", "dart_package_metadata", "dart_test")

# One package split across BUILD files under `lib/`, one target per directory,
# as Gazelle generates it. The declaration here, beside where `pubspec.yaml`
# would be, is what makes this directory their package root.
dart_package_metadata(
    name = "pkg",
    package_name = "subdir_root_fixture",
    language_version = "3.11",
    visibility = ["//dart/tests/subdir_root_fixture:__subpackages__"],
)

dart_library(
    name = "subdir_root_fixture",
    srcs = ["lib/subdir_root_fixture.dart"],
    package = ":pkg",
    deps = ["//dart/tests/subdir_root_fixture/lib/src/view"],
)

dart_test(
    name = "subdir_root_test",
    size = "small",
    main = "test/subdir_root_test.dart",
    deps = [":subdir_root_fixture"],
)
